# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="Visarjan Ghat Watch"
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────────────────────────────
# Provide the full PostgreSQL DSN. asyncpg is used for async; psycopg2 for Alembic sync.
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/ghatwatch
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:changeme@localhost:5432/ghatwatch

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Admin Bootstrap (used only by `python -m app.scripts.create_admin`) ─────
BOOTSTRAP_ADMIN_EMAIL=admin@bmc.gov.in
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_BEFORE_USE

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=paste_temporary_token
WHATSAPP_PHONE_NUMBER_ID=paste_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=paste_waba_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=create_your_own_secret


WHATSAPP_DRY_RUN=true
# Dry-run: true = simulate sends without calling Meta API
WHATSAPP_DRY_RUN=true

# ─── Data Quality ────────────────────────────────────────────────────────────
# Number of days after which a water-quality reading is considered stale
DATA_FRESHNESS_THRESHOLD_DAYS=90

# ─── CORS (comma-separated origins) ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
 


 GITHUB_TOKEN=your_personal_access_token
GITHUB_REPO_OWNER=Vishal4742
GITHUB_REPO_NAME=bhopal-impact-lab-2026-problem-statements
GITHUB_BRANCH=main